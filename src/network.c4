specification {
  element system
  element storage

  relationship primary {
	color green
  }
  relationship secondary {
	color amber
  }
  relationship reverse {
    head none
    tail normal
  }
}

model {
  unifiDreamMachine = system 'Dream Machine Pro' {
    description 'Home network gateway and controller'
    technology 'UniFi'
  }

  unifiSW24 = system 'Switch 24 Pro' {
    description 'Layer 3 switch'
    technology 'UniFi'
  }

  unifiSW8 = system 'Ultra 60W' {
    description 'Layer 2 switch'
    technology 'UniFi'
  }

  unifiU6L1 = storage 'U6 Lite' {
    description 'WiFi 6 Access Point'
	  technology 'Unifi'
  }

  unifiU6L2 = storage 'U6 Lite' {
    description 'WiFi 6 Access Point'
	  technology 'Unifi'
  }

  unifiU6L3 = storage 'U6 Lite' {
    description 'WiFi 6 Access Point'
	  technology 'Unifi'
  }

  nas = storage 'NAS' {
    description 'Network-attached storage'
	  technology 'TrueNas'
  }

  proxmox = system 'Server' {
    description 'Virtualization Server'
    technology 'Proxmox'
  }

  camG5B = storage 'G5 Bullet' {
    description '2K HD PoE Camera'
	  technology 'Unifi'
  }

  camG4B1 = storage 'G4 Bullet' {
    description '2K HD PoE Camera'
	  technology 'Unifi'
  }

  camG4B2 = storage 'G4 Bullet' {
    description '2K HD PoE Camera'
	  technology 'Unifi'
  }

  camG4B3 = storage 'G4 Bullet' {
    description '2K HD PoE Camera'
	  technology 'Unifi'
  }

  camG4I = storage 'G4 Instant' {
    description '2K HD WiFi Camera'
	  technology 'Unifi'
  }

  camG4Door = storage 'G4 Doorbell' {
    description 'WiFi Doorbell'
	  technology 'Unifi'
  }

  unifiDreamMachine -[primary]-> nas 'Primary'
  nas -[primary]-> unifiDreamMachine 'Primary'

  unifiDreamMachine -[secondary]-> nas 'Backup'
  nas -[secondary]-> unifiDreamMachine 'Backup'

  unifiSW24 -> proxmox

  unifiDreamMachine -> unifiSW24
  unifiSW24 -> unifiDreamMachine

  unifiSW24 -> unifiSW8
  unifiSW8 -> unifiSW24

  unifiSW8 -[reverse]-> camG5B
  unifiSW8 -[reverse]-> camG4B1
  unifiSW8 -[reverse]-> camG4B2
  unifiSW8 -[reverse]-> camG4B3
  unifiSW8 -[reverse]-> camG4I

  unifiSW24 -> unifiU6L1
  unifiU6L1 -> unifiSW24

  unifiSW24 -> unifiU6L2
  unifiU6L2 -> unifiSW24

  unifiSW24 -> unifiU6L3
  unifiU6L3 -> unifiSW24

  unifiU6L1 -[reverse]-> camG4Door

}

views {
  view network {
    title 'Home network'
    include *
  }
}